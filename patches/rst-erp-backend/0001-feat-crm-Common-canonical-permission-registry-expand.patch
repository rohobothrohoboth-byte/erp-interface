diff --git a/src/Svc.Auth/Middlewares/MigrationExt.cs b/src/Svc.Auth/Middlewares/MigrationExt.cs
index 1b9f56d..c27dd9e 100644
--- a/src/Svc.Auth/Middlewares/MigrationExt.cs
+++ b/src/Svc.Auth/Middlewares/MigrationExt.cs
@@ -269,10 +269,11 @@ public static class MigrationExt
   }
 
 
-    // Initialize the in-memory permission registry (PermissionMap.IndexMap) from
-    // the seeded permission keys so the JWT `ph` bitmask and [PerAuth] policies
-    // cover every real permission, not just the legacy static list. Keys are
-    // ordered deterministically so bit indices are stable across restarts.
+    // Initialize the in-memory permission registry from the shared Common
+    // canonical key list so JWT `ph` bit indices match every other service that
+    // calls PermissionMap.InitializeFromCanonical() — no cross-service coupling.
+    // Then compare against DB PerApi keys and log drift (extra/missing) without
+    // changing the live index map (indices must stay identical across services).
     public static async Task InitializePermissionRegistry(this IApplicationBuilder app)
     {
         using var scope = app.ApplicationServices.CreateScope();
@@ -281,23 +282,45 @@ public static class MigrationExt
 
         try
         {
+            PermissionMap.InitializeFromCanonical();
+            logger.LogInformation(
+                "Permission registry initialized from Common canonical keys ({Count} permissions)",
+                PermissionMap.IndexMap.Count);
+
             if (!await dbContext.Database.CanConnectAsync())
             {
-                logger.LogWarning("Cannot connect to database for permission registry init");
+                logger.LogWarning("Cannot connect to database to verify permission registry drift");
                 return;
             }
 
-            var keys = await dbContext.PerApi
+            var dbKeys = await dbContext.PerApi
                 .Where(a => !a.IsDeleted)
                 .Select(a => a.Key)
                 .ToListAsync();
 
-            PermissionMap.Initialize(keys);
-            logger.LogInformation($"Permission registry initialized with {PermissionMap.IndexMap.Count} permissions");
+            var canonical = new HashSet<string>(PermissionRegistry.CanonicalKeys, StringComparer.Ordinal);
+            var dbSet = new HashSet<string>(dbKeys.Where(k => !string.IsNullOrWhiteSpace(k)), StringComparer.Ordinal);
+            var missingInDb = canonical.Except(dbSet).Take(20).ToList();
+            var extraInDb = dbSet.Except(canonical).Take(20).ToList();
+
+            if (missingInDb.Count == 0 && extraInDb.Count == 0)
+            {
+                logger.LogInformation("Permission registry matches DB PerApi keys (no drift)");
+            }
+            else
+            {
+                logger.LogWarning(
+                    "Permission registry drift vs DB: missingInDb={MissingCount} (sample: {Missing}), extraInDb={ExtraCount} (sample: {Extra}). " +
+                    "JWT/PerAuth indices follow Common.PermissionRegistry — update seeders + regenerate CanonicalKeys if intentional.",
+                    missingInDb.Count, string.Join(", ", missingInDb),
+                    extraInDb.Count, string.Join(", ", extraInDb));
+            }
         }
         catch (Exception ex)
         {
             logger.LogError(ex, "Error initializing permission registry");
+            // Fall back to canonical even on verification failure.
+            PermissionMap.InitializeFromCanonical();
         }
     }
 
